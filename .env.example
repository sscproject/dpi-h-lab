# Copy to .env. Without DATABASE_URL the server uses an embedded PGlite database in PGLITE_DIR.
PORT=3000
# DATABASE_URL=postgres://dpih:dpih@localhost:5432/dpih
PGLITE_DIR=.data/pglite
# Required in production: at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
# Database password for docker compose (local trial). Use a strong one anywhere else.
POSTGRES_PASSWORD=
# Public address of the site, used in join links and QR codes, e.g. https://lab.example.org
PUBLIC_URL=
RATE_LIMIT_PER_MINUTE=120
# How often sessions and teams auto-open and auto-close, in milliseconds (0 turns it off).
SWEEP_MS=5000
# Days without activity before an open team or session closes on its own.
IDLE_DAYS=14
# Days a closed team stays viewable with its team code.
CODE_READ_DAYS=90
# Proxies in front of the app whose X-Forwarded-For is trusted: 0 when reached directly,
# 1 behind one proxy (e.g. Caddy or nginx on the same server). Production defaults to 1.
TRUST_PROXY=0
