{
  "name": "dpi-h-lab",
  "version": "0.1.0",
  "description": "DPI-H Lab: country teams map their Digital Public Infrastructure for Health pathway together. Informed by the WHO/ITU DPI-H Reference Architecture Draft V1.0.",
  "license": "Apache-2.0",
  "author": "The DPI-H Lab authors (see AUTHORS)",
  "contributors": [
    "Umer Nisar (CSIRO SSCP)",
    "Rumanusina Maua (SPC)",
    "Jordi Piera Jimenez"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sscproject/dpi-h-lab.git"
  },
  "homepage": "https://github.com/sscproject/dpi-h-lab#readme",
  "bugs": {
    "url": "https://github.com/sscproject/dpi-h-lab/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/main.ts --port 3000 --dev-client http://localhost:5173",
    "dev:client": "vite",
    "build": "npm run content:build && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/main.js",
    "content:build": "tsx scripts/content-build.ts",
    "migrate": "tsx server/migrate-cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.5",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.7",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.7",
    "pg": "^8.23.1",
    "qrcode-generator": "^1.5.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
